
    @model IEnumerable<OrderDetailViewInfo>
    @{
        Layout = null;

        int stt = 0;
        decimal sumPrice = 0;
    }



    <div class="card card-outline card-success">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-cart"></i>
                Danh sách mặt hàng đã chọn
            </h5>
        </div>

        <div class="card-body">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-success">
                    <tr>
                        <th class="text-center">#</th>
                        <th style="width:auto">Tên hàng</th>
                        <th class="text-center" style="width:100px">ĐVT</th>
                        <th class="text-center" style="width:100px">SL</th>
                        <th class="text-end" style="width:150px">Giá</th>
                        <th class="text-end" style="width:150px">Thành tiền</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        stt++;
                        sumPrice += item.TotalPrice;
                        <tr>
                            <td class="text-center">@stt</td>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Unit</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.SalePrice</td>
                            <td class="text-end">@item.TotalPrice</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-primary" type="button"
                                        onclick="showEditCartItem('@item.ProductID')">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button class="btn btn-sm btn-danger" type="button"
                                        onclick="removeCartItem('@item.ProductID')">
                                    <i class="bi bi-dash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end">Tổng cộng:</th>
                        <th class="text-end">@sumPrice</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>

            <div class="text-end">
                <a class="btn btn-sm btn-danger mt-2 open-modal"
                   href="~/Order/ClearCart">
                    <i class="bi bi-trash"></i>
                    Xóa giỏ hàng
                </a>
            </div>
        </div>
    </div>

<script>
    // Hàm hiển thị Modal chỉnh sửa
    function showEditCartItem(id) {
        $.ajax({
            url: "/Order/EditCartItem",
            type: "GET",
            data: { productID: id },
            success: function (data) {
                // Nạp nội dung vào đúng vùng modal-content của Layout
                $("#dialogModal .modal-content").html(data);
                // Hiển thị modal
                var modalElem = document.getElementById('dialogModal');
                var myModal = new bootstrap.Modal(modalElem);
                myModal.show();
            },
            error: function() {
                alert("Không thể tải thông tin sản phẩm.");
            }
        });
    }

    // Hàm thực hiện cập nhật sau khi nhấn Lưu trong Modal
    function ajaxUpdateCart() {
        var $form = $("#formEditCart");
        var url = $form.attr("action");
        var postData = $form.serialize();

        $.ajax({
            url: url,
            type: "POST",
            data: postData,
            success: function (res) {
                // Kiểm tra code (dựa trên cấu trúc API của bạn thường dùng code: 1 là thành công)
                if (res.code !== 0 || res.isSuccess) {
                    // 1. Tắt modal
                    var modalElem = document.getElementById('dialogModal');
                    var modal = bootstrap.Modal.getInstance(modalElem);
                    if (modal) modal.hide();

                    // 2. Gọi hàm load lại giỏ hàng (Phải khớp tên ở trang cha)
                    if (typeof showCart === "function") {
                        showCart();
                    } else {
                        location.reload();
                    }
                } else {
                    alert(res.message || "Có lỗi xảy ra");
                }
            }
        });
    }

    // Hàm xóa item (để khớp với nút bấm onclick="removeCartItem")
    function removeCartItem(id) {
        if (confirm("Bạn có chắc muốn xóa mặt hàng này khỏi giỏ hàng?")) {
            // Gọi lại hàm đã có ở trang cha cho đồng nhất
            if (typeof deleteCartItem === "function") {
                deleteCartItem(id);
            }
        }
    }
</script>


